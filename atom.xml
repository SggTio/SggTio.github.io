---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

 <title>{{ site.title }}</title>
 <link href="{{ '/atom.xml' | relative_url }}" rel="self"/>
 <link href="{{ site.url }}{{ site.baseurl }}/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.url }}</id>
 <author>
   <name>{{ site.author.name }}</name>
   <email>{{ site.author.email }}</email>
 </author>

 {%- comment -%} Sin draft ni listar: false (D10), por fecha descendente. {%- endcomment -%}
 {%- include publicaciones.html %}
 {% for item in publicaciones %}
 <entry>
   <title>{{ item.title | xml_escape }}</title>
   <link href="{{ site.url }}{{ site.baseurl }}{{ item.url }}"/>
   <updated>{{ item.date | date_to_xmlschema }}</updated>
   <id>{{ site.url }}{{ item.url }}</id>
   <content type="html">{{ item.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
